# Example only — NEVER commit real passwords or APP_KEY.
# Copy to /srv/carfolk/shared/.env with mode 0600; fill from a secret manager.
APP_NAME="Carfolk LTD"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://cars.example.com
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=carfolk
DB_USERNAME=carfolk_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=90
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SESSION_COOKIE=carfolk_session

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

CARFOLK_PUBLIC_URL=https://cars.example.com
# Both disabled until client supplies verified, approved legal/business data.
CARFOLK_LEADS_ENABLED=false
CARFOLK_PRIVACY_URL=
CARFOLK_SEO_ENABLED=false
