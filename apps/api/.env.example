APP_NAME="Carfolk LTD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=carfolk
DB_USERNAME=carfolk
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=90
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12
# In production set APP_ENV=production, APP_DEBUG=false, APP_URL=https://...
# DB_PASSWORD / APP_KEY are secrets, never commit. Set SESSION_SECURE_COOKIE=true over HTTPS.

# Disable PII collection until legal privacy terms and operational handling are approved.
CARFOLK_LEADS_ENABLED=false
CARFOLK_PRIVACY_URL=

CARFOLK_RETENTION_APPROVED=false
CARFOLK_RETENTION_DAYS=0
