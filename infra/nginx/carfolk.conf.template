# Carfolk LTD — deploy ONLY after replacing __DOMAIN__ and configuring valid TLS files.
# Public domain serves React and forwards API, Laravel admin, SEO, and health paths.
server {
    listen 80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name __DOMAIN__;
    root /srv/carfolk/current/apps/web/dist;
    index index.html;
    charset utf-8;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 48m; # Up to five vehicle photos at 8 MB each, plus multipart overhead.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Stay noindex until approved inventory, legal copy, SSL, and domain verification.
    # REMOVE THE NEXT LINE ONLY after the signed launch gate is approved.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }

    location ^~ /storage/ {
        if ($uri !~* \\.(?:jpg|jpeg|png|webp)$) { return 404; }
        alias /srv/carfolk/shared/public-storage/;
        autoindex off;
        limit_except GET HEAD { deny all; }
        try_files $uri =404;
        expires 7d;
    }

    location ~ ^/(?:api/|manage(?:/|$)|listing/|robots\.txt$|sitemap\.xml$|up$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/carfolk/current/apps/api/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_read_timeout 30s;
    }

    # Never serve hidden files, the PHP source tree or PHP as downloads.
    location ~ /\. { deny all; }
    location ~* \.(?:php|phtml|phar|env|sql|bak|log)$ { return 404; }

    location / {
        try_files $uri $uri/ /index.html;
        # Hash-router frontend; real search crawler entry points are /listing/{slug}.
    }
    location ~* \.(?:js|css|svg|png|jpg|jpeg|webp|ico|woff2)$ {
        try_files $uri =404;
        expires 7d;
    }
}
